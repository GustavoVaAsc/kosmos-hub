---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import ClubHeader from '../../components/ClubHeader.astro';
import { SITE_TITLE, base } from '../../consts';
import '../../styles/club-classes.css';

export async function getStaticPaths() {
    // Filter drafts at the query boundary so they don't leak into the
    // generated static routes (which would otherwise 200 a draft URL).
    const entries = await getCollection('clubClasses', ({ data }) => !data.draft);
    return entries.map((entry) => ({
        params: { slug: entry.id },
        props: entry,
    }));
}

type Props = CollectionEntry<'clubClasses'>;
const entry = Astro.props;
const { Content } = await render(entry);
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead title={entry.data.title} description={entry.data.description} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=JetBrains+Sans:wght@300;400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
            integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
            crossorigin="anonymous"
        />
    </head>
    <body class="club-theme">
        <ClubHeader currentPage={entry} />
        <div class="club-content">
            <div class="club-content-header">
                <h1 class="club-content-title">{entry.data.title}</h1>
                <p class="club-content-description">{entry.data.description}</p>
            </div>
            <Content />
        </div>
    </body>
</html>
