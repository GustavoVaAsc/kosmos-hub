---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import ClubHeader from '../../components/ClubHeader.astro';
import { SITE_TITLE, base } from '../../consts';
import '../../styles/club-classes.css';

// Sort by `order` (manual curation), then by title for stable alphabetical
// fallback when multiple entries share the same `order`.
const entries = (await getCollection('clubClasses', ({ data }) => !data.draft)).sort(
    (a, b) =>
        (a.data.order ?? 0) - (b.data.order ?? 0) ||
        a.data.title.localeCompare(b.data.title),
);
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead
            title="CPCFI Classes | {SITE_TITLE}"
            description="Competitive Programming classes for CPCFI"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=JetBrains+Sans:wght@300;400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="club-theme">
        <ClubHeader currentPage="menu" />

        <div class="club-container">
            <div class="club-header">
                <h1 class="club-title">CPCFI Classes</h1>
                <p class="club-subtitle">
                    Competitive Programming &amp; Data Structures
                </p>
            </div>

            <div class="club-menu-grid">
                {
                    entries.map((entry) => (
                        <a
                            href={`${base}/club-classes/${entry.id}`}
                            class="club-menu-option"
                        >
                            <div class="club-menu-content">
                                <span class="club-menu-name">{entry.data.title}</span>
                                <span class="club-menu-subtitle">
                                    {entry.data.description}
                                </span>
                            </div>
                            <span class="club-menu-chevron" aria-hidden="true">›</span>
                        </a>
                    ))
                }
            </div>
        </div>
    </body>
</html>
