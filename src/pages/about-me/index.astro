---
import BaseHead from "../../components/BaseHead.astro";
import Statusline from "../../components/Statusline.astro";
import TechIcon from "../../components/TechIcon.astro";
import { SITE_DESCRIPTION, SITE_TITLE, base } from "../../consts";
import "../../styles/portfolio.css";
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap"
            rel="stylesheet"
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'Person',
                name: 'Gustavo Valenzuela',
                url: 'https://gustavovaasc.github.io/kosmos-hub/about-me/',
                description:
                    'Programador competitivo e ingeniero de software. Creando soluciones elegantes a problemas complejos.',
                sameAs: [
                    'https://github.com/gustavovaasc',
                ],
                knowsAbout: [
                    'Competitive Programming',
                    'Software Engineering',
                    'Algorithms',
                    'Data Structures',
                ],
                inLanguage: ['es', 'en'],
            })}
        />
    </head>
    <body>
        <a class="skip-to-content" href="#main-content">Saltar al contenido</a>

        <Statusline
            path="about-me"
            column="Ln 1, Col 1"
            encoding="utf-8 unix"
        />

        <main id="main-content" tabindex="-1" class="about-me">
            <a href={`${base}/`} class="terminal-cmd back-link">
                <span class="terminal-cmd-prefix" aria-hidden="true">:</span><span
                    class="terminal-cmd-name">back</span
                >
                <span class="terminal-cmd-desc">Volver al menú principal</span>
            </a>

            <!-- Hero: bio + signature Neovim code window -->
            <section
                class="terminal-window about-hero"
                aria-label="Sobre mí"
            >
                <div class="hero-banner">
                    <p class="hero-greeting">Hola, soy</p>
                    <h1 class="hero-name">Gustavo Valenzuela</h1>
                    <h2 class="hero-title">
                        Programador Competitivo e Ingeniero de Software
                    </h2>
                    <p class="hero-description">
                        Creando soluciones elegantes a problemas complejos.
                        Apasionado por el código limpio, tecnologías innovadoras
                        y experiencias digitales que generan impacto.
                    </p>
                    <nav
                        class="hero-commands"
                        aria-label="Acciones rápidas"
                    >
                        <a href="#projects" class="terminal-cmd">
                            <span class="terminal-cmd-prefix" aria-hidden="true"
                                >:</span
                            ><span class="terminal-cmd-name">projects</span>
                            <span class="terminal-cmd-desc">Ver mis proyectos</span>
                        </a>
                        <a href="#contact" class="terminal-cmd">
                            <span class="terminal-cmd-prefix" aria-hidden="true"
                                >:</span
                            ><span class="terminal-cmd-name">contact</span>
                            <span class="terminal-cmd-desc">Hablemos</span>
                        </a>
                    </nav>
                </div>

                <div class="code-window" aria-label="Neovim: Developer.cpp">
                    <div class="window-header">
                        <div class="window-controls">
                            <span class="gnome-btn gnome-close"></span>
                            <span class="gnome-btn gnome-minimize"></span>
                            <span class="gnome-btn gnome-maximize"></span>
                        </div>
                        <span class="window-title">nvim ~/Developer.cpp</span>
                        <div class="window-menu">
                            <span>⋮</span>
                        </div>
                    </div>
                    <div class="code-content">
                        <Statusline path="Developer.cpp" />
                        <pre><code><span class="line-number"> 1</span> <span class="code-keyword">#include</span> <span class="code-string">&lt;iostream&gt;</span>
<span class="line-number"> 2</span> <span class="code-keyword">#include</span> <span class="code-string">&lt;vector&gt;</span>
<span class="line-number"> 3</span> <span class="code-keyword">#include</span> <span class="code-string">&lt;string&gt;</span>
<span class="line-number"> 4</span>
<span class="line-number"> 5</span> <span class="code-keyword">class</span> <span class="code-class">Developer</span> {'{'}
<span class="line-number"> 6</span> <span class="code-keyword">private</span>:
<span class="line-number"> 7</span>     std::<span class="code-class">string</span> <span class="code-variable">name</span>;
<span class="line-number"> 8</span>     std::<span class="code-class">vector</span>&lt;std::<span class="code-class">string</span>&gt; <span class="code-variable">skills</span>;
<span class="line-number"> 9</span>
<span class="line-number">10</span> <span class="code-keyword">public</span>:
<span class="line-number">11</span>     <span class="code-function">Developer</span>() : <span class="code-variable">name</span>(<span class="code-string">"Gustavo"</span>) {'{'}
<span class="line-number">12</span>         <span class="code-variable">skills</span> = {'{'}<span class="code-string">"C++"</span>, <span class="code-string">"Python"</span>, <span class="code-string">"Algorithms"</span>{'}'};
<span class="line-number">13</span>     {'}'}
<span class="line-number">14</span> {'}'};</code></pre>
                        <div class="nvim-cmdline">
                            <span class="nvim-cmdline-text" id="cmdline-text"></span><span
                                class="nvim-cursor">█</span
                            >
                            <input
                                type="text"
                                id="cmdline-input"
                                class="nvim-cmdline-input"
                                autocomplete="off"
                                spellcheck="false"
                                autocapitalize="off"
                                autocorrect="off"
                                aria-label="Línea de comandos de Neovim"
                            />
                        </div>
                    </div>
                </div>
            </section>

            <hr class="terminal-divider" />

            <!-- About -->
            <section
                id="about"
                class="terminal-window section-panel"
                aria-label="Sobre mí"
            >
                <h2 class="section-heading">
                    <span class="terminal-cmd-prefix" aria-hidden="true">:</span
                    >about
                </h2>
                <p class="section-text">
                    Estudiante de Ingeniería en Computación con una fuerte
                    pasión por la programación competitiva, desarrollo de
                    software, machine learning y computación cuántica. En
                    constante búsqueda de nuevos conocimientos en el mundo
                    de las ciencias de la computación.
                </p>
            </section>

            <hr class="terminal-divider" />

            <!-- Skills -->
            <section
                id="skills"
                class="terminal-window section-panel"
                aria-label="Habilidades técnicas"
            >
                <h2 class="section-heading">
                    <span class="terminal-cmd-prefix" aria-hidden="true">:</span
                    >tech
                </h2>

                <div class="skill-group">
                    <h3 class="skill-group-title">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        >lang
                    </h3>
                    <ul class="skill-tags">
                        <li class="skill-tag"><TechIcon name="c" />c</li>
                        <li class="skill-tag"><TechIcon name="c++" />c++</li>
                        <li class="skill-tag"><TechIcon name="python" />python</li>
                        <li class="skill-tag"><TechIcon name="java" />java</li>
                        <li class="skill-tag"><TechIcon name="typescript" />typescript</li>
                        <li class="skill-tag"><TechIcon name="kotlin" />kotlin</li>
                    </ul>
                </div>

                <div class="skill-group">
                    <h3 class="skill-group-title">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        >mobile
                    </h3>
                    <ul class="skill-tags">
                        <li class="skill-tag"><TechIcon name="android-studio" />android-studio</li>
                        <li class="skill-tag"><TechIcon name="kotlin" />kotlin</li>
                        <li class="skill-tag"><TechIcon name="swift" />swift</li>
                        <li class="skill-tag"><TechIcon name="swiftui" />swiftui</li>
                    </ul>
                </div>

                <div class="skill-group">
                    <h3 class="skill-group-title">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        >backend
                    </h3>
                    <ul class="skill-tags">
                        <li class="skill-tag"><TechIcon name="next.js" />next.js</li>
                        <li class="skill-tag"><TechIcon name="python" />python</li>
                        <li class="skill-tag"><TechIcon name="postgresql" />postgresql</li>
                        <li class="skill-tag"><TechIcon name="sql-server" />sql-server</li>
                        <li class="skill-tag"><TechIcon name="docker" />docker</li>
                    </ul>
                </div>

                <div class="skill-group">
                    <h3 class="skill-group-title">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        >tools
                    </h3>
                    <ul class="skill-tags">
                        <li class="skill-tag"><TechIcon name="git" />git</li>
                        <li class="skill-tag"><TechIcon name="docker" />docker</li>
                        <li class="skill-tag"><TechIcon name="linux" />linux</li>
                        <li class="skill-tag"><TechIcon name="latex" />latex</li>
                        <li class="skill-tag"><TechIcon name="pandas" />pandas</li>
                        <li class="skill-tag"><TechIcon name="matplotlib" />matplotlib</li>
                        <li class="skill-tag"><TechIcon name="neovim" />neovim</li>
                    </ul>
                </div>

                <div class="skill-group">
                    <h3 class="skill-group-title">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        >gamedev
                    </h3>
                    <ul class="skill-tags">
                        <li class="skill-tag"><TechIcon name="opengl" />opengl</li>
                        <li class="skill-tag"><TechIcon name="blender" />blender</li>
                        <li class="skill-tag"><TechIcon name="sfml" />sfml</li>
                        <li class="skill-tag"><TechIcon name="pygame" />pygame</li>
                        <li class="skill-tag"><TechIcon name="glsl" />glsl</li>
                        <li class="skill-tag"><TechIcon name="java-awt" />java-awt</li>
                        <li class="skill-tag"><TechIcon name="c++" />c++</li>
                    </ul>
                </div>

                <div class="skill-group">
                    <h3 class="skill-group-title">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        >ai
                    </h3>
                    <ul class="skill-tags">
                        <li class="skill-tag"><TechIcon name="github-copilot" />github-copilot</li>
                        <li class="skill-tag"><TechIcon name="google-ai" />google-ai</li>
                        <li class="skill-tag"><TechIcon name="opencode" />opencode</li>
                        <li class="skill-tag"><TechIcon name="llama.cpp" />llama.cpp</li>
                        <li class="skill-tag"><TechIcon name="rag" />rag</li>
                    </ul>
                </div>
            </section>

            <hr class="terminal-divider" />

            <!-- Projects -->
            <section
                id="projects"
                class="terminal-window section-panel"
                aria-label="Proyectos"
            >
                <h2 class="section-heading">
                    <span class="terminal-cmd-prefix" aria-hidden="true">:</span
                    >projects
                </h2>

                <article class="terminal-cmd project-row">
                    <div class="project-row-header">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        ><span class="terminal-cmd-name">bizarre-jump</span>
                        <span class="project-year">2023</span>
                    </div>
                    <p class="project-row-desc">
                        Juego de plataformas arcade en 2D creado en Java
                        usando AWT y Swing. Con mecánicas de juego simples y
                        física fluida.
                    </p>
                    <ul class="project-row-tech">
                        <li class="skill-tag"><TechIcon name="java" />java</li>
                        <li class="skill-tag"><TechIcon name="awt" />awt</li>
                        <li class="skill-tag"><TechIcon name="swing" />swing</li>
                    </ul>
                </article>

                <article class="terminal-cmd project-row">
                    <div class="project-row-header">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        ><span class="terminal-cmd-name">task-management-app</span>
                    </div>
                    <p class="project-row-desc">
                        Herramienta colaborativa de gestión de tareas con
                        actualizaciones en tiempo real, funciones de
                        colaboración en equipo y análisis de productividad.
                    </p>
                    <ul class="project-row-tech">
                        <li class="skill-tag"><TechIcon name="vue.js" />vue.js</li>
                        <li class="skill-tag"><TechIcon name="firebase" />firebase</li>
                        <li class="skill-tag"><TechIcon name="typescript" />typescript</li>
                    </ul>
                </article>

                <article class="terminal-cmd project-row">
                    <div class="project-row-header">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        ><span class="terminal-cmd-name">design-system-library</span>
                    </div>
                    <p class="project-row-desc">
                        Librería de componentes integral con enfoque en
                        accesibilidad, soporte para modo oscuro y
                        documentación extensa.
                    </p>
                    <ul class="project-row-tech">
                        <li class="skill-tag"><TechIcon name="react" />react</li>
                        <li class="skill-tag"><TechIcon name="storybook" />storybook</li>
                        <li class="skill-tag"><TechIcon name="css-in-js" />css-in-js</li>
                    </ul>
                </article>
            </section>

            <hr class="terminal-divider" />

            <!-- Setup -->
            <section
                id="setup"
                class="terminal-window section-panel"
                aria-label="Mi configuración"
            >
                <h2 class="section-heading">
                    <span class="terminal-cmd-prefix" aria-hidden="true">:</span
                    >setup
                </h2>

                <div class="setup-group">
                    <h3 class="skill-group-title">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        >os
                    </h3>
                    <ul class="setup-list">
                        <li>Arch Linux (btw)</li>
                        <li>Windows 11 (doble arranque)</li>
                        <li>Entorno de escritorio GNOME</li>
                    </ul>
                </div>

                <div class="setup-group">
                    <h3 class="skill-group-title">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        >editor
                    </h3>
                    <ul class="setup-list">
                        <li>Neovim (principal)</li>
                        <li>VS Code (secundario)</li>
                        <li>Tema Tokyo Night</li>
                    </ul>
                </div>

                <div class="setup-group">
                    <h3 class="skill-group-title">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        >peripherals
                    </h3>
                    <ul class="setup-list">
                        <li>Teclado mecánico</li>
                        <li>Ratón para gaming</li>
                        <li>Auriculares con cancelación de ruido</li>
                    </ul>
                </div>

                <div class="setup-group">
                    <h3 class="skill-group-title">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        >terminal
                    </h3>
                    <ul class="setup-list">
                        <li>Zsh con Oh My Zsh</li>
                        <li>tmux para multiplexación</li>
                        <li>Prompt Starship</li>
                    </ul>
                </div>
            </section>

            <hr class="terminal-divider" />

            <!-- Hobbies -->
            <section
                id="hobbies"
                class="terminal-window section-panel"
                aria-label="Pasatiempos"
            >
                <h2 class="section-heading">
                    <span class="terminal-cmd-prefix" aria-hidden="true">:</span
                    >hobbies
                </h2>

                <article class="terminal-cmd hobby-row">
                    <div class="project-row-header">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        ><span class="terminal-cmd-name">competitive</span>
                    </div>
                    <p class="project-row-desc">
                        Resolviendo desafíos algorítmicos en plataformas como
                        Codeforces, LeetCode, y participando en concursos de
                        programación.
                    </p>
                </article>

                <article class="terminal-cmd hobby-row">
                    <div class="project-row-header">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        ><span class="terminal-cmd-name">gaming</span>
                    </div>
                    <p class="project-row-desc">
                        Disfrutando juegos de estrategia, RPGs y títulos indie.
                        También interesado en desarrollo y diseño de juegos.
                    </p>
                </article>

                <article class="terminal-cmd hobby-row">
                    <div class="project-row-header">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        ><span class="terminal-cmd-name">reading</span>
                    </div>
                    <p class="project-row-desc">
                        Leyendo sobre ciencias de la computación, matemáticas,
                        ciencia ficción y tendencias tecnológicas.
                    </p>
                </article>

                <article class="terminal-cmd hobby-row">
                    <div class="project-row-header">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        ><span class="terminal-cmd-name">music</span>
                    </div>
                    <p class="project-row-desc">
                        Escuchando varios géneros mientras programo, desde
                        lo-fi beats hasta música clásica.
                    </p>
                </article>

                <article class="terminal-cmd hobby-row">
                    <div class="project-row-header">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        ><span class="terminal-cmd-name">learning</span>
                    </div>
                    <p class="project-row-desc">
                        Explorando nuevas tecnologías, frameworks y
                        manteniéndome actualizado con lo último en tecnología.
                    </p>
                </article>

                <article class="terminal-cmd hobby-row">
                    <div class="project-row-header">
                        <span class="terminal-cmd-prefix" aria-hidden="true"
                            >:</span
                        ><span class="terminal-cmd-name">opensource</span>
                    </div>
                    <p class="project-row-desc">
                        Contribuyendo a proyectos de código abierto y
                        colaborarando con la comunidad de desarrolladores.
                    </p>
                </article>
            </section>

            <hr class="terminal-divider" />

            <!-- Contact -->
            <section
                id="contact"
                class="terminal-window section-panel"
                aria-label="Contacto"
            >
                <h2 class="section-heading">
                    <span class="terminal-cmd-prefix" aria-hidden="true">:</span
                    >contact
                </h2>
                <p class="contact-description">
                    Siempre estoy abierto a discutir nuevos proyectos, ideas
                    creativas u oportunidades para ser parte de tu visión.
                </p>

                <a
                    href="mailto:your.email@example.com"
                    class="terminal-cmd contact-row"
                >
                    <span class="terminal-cmd-prefix" aria-hidden="true">:</span
                    ><span class="terminal-cmd-name">email</span>
                    <span class="terminal-cmd-desc">your.email@example.com</span>
                </a>

                <a
                    href="https://github.com/yourusername"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="terminal-cmd contact-row"
                >
                    <span class="terminal-cmd-prefix" aria-hidden="true">:</span
                    ><span class="terminal-cmd-name">github</span>
                    <span class="terminal-cmd-desc">@yourusername</span>
                </a>

                <a
                    href="https://linkedin.com/in/yourusername"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="terminal-cmd contact-row"
                >
                    <span class="terminal-cmd-prefix" aria-hidden="true">:</span
                    ><span class="terminal-cmd-name">linkedin</span>
                    <span class="terminal-cmd-desc">/in/yourusername</span>
                </a>
            </section>

            <hr class="terminal-divider" />

            <a href={`${base}/`} class="terminal-cmd back-link back-link--bottom">
                <span class="terminal-cmd-prefix" aria-hidden="true">:</span><span
                    class="terminal-cmd-name">back</span
                >
                <span class="terminal-cmd-desc">Volver al menú principal</span>
            </a>
        </main>

        <script>
            import "../../scripts/about-cmdline.js";
        </script>
    </body>
</html>
