---
import BaseHead from "../../components/BaseHead.astro";
import Statusline from "../../components/Statusline.astro";
import { SITE_DESCRIPTION, SITE_TITLE, base } from "../../consts";
import "../../styles/portfolio.css";
---

<!doctype html>
<html lang="es">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap"
            rel="stylesheet"
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'Person',
                name: 'Gustavo Valenzuela',
                url: 'https://gustavovaasc.github.io/kosmos-hub/about-me/',
                description:
                    'Competitive programmer and software engineer. Crafting elegant solutions to complex problems.',
                sameAs: [
                    'https://github.com/gustavovaasc',
                ],
                knowsAbout: [
                    'Competitive Programming',
                    'Software Engineering',
                    'Algorithms',
                    'Data Structures',
                ],
                inLanguage: ['es', 'en'],
            })}
        />
    </head>
    <body>
        <a class="skip-to-content" href="#main-content">Saltar al contenido</a>

        <!-- Language Toggle -->
        <button
            id="lang-toggle"
            class="lang-toggle"
            aria-label="Toggle Language"
        >
            <span class="lang-option" data-lang="en">EN</span>
            <span class="lang-divider">/</span>
            <span class="lang-option" data-lang="es">ES</span>
        </button>

        <!-- Navigation -->
        <nav class="main-nav">
            <div class="nav-container">
                <a href={`${base}/`} class="logo">&lt;/&gt;</a>
                <ul class="nav-links">
                    <li><a href="#about" data-i18n="nav.about">About</a></li>
                    <li><a href="#skills" data-i18n="nav.skills">Skills</a></li>
                    <li>
                        <a href="#projects" data-i18n="nav.projects">Projects</a
                        >
                    </li>
                    <li>
                        <a href="#contact" data-i18n="nav.contact">Contact</a>
                    </li>
                </ul>
            </div>
        </nav>

        <main id="main-content" tabindex="-1">
        <!-- Hero Section -->
        <section class="hero">
            <div class="hero-content">
                <div class="hero-text">
                    <p class="greeting" data-i18n="hero.greeting">Hi, I'm</p>
                    <h1 class="name" data-i18n="hero.name">
                        Gustavo Valenzuela
                    </h1>
                    <h2 class="title" data-i18n="hero.title">
                        Competitive Programmer & Software Engineer
                    </h2>
                    <p class="description" data-i18n="hero.description">
                        Crafting elegant solutions to complex problems.
                        Passionate about clean code, innovative technologies,
                        and building impactful digital experiences.
                    </p>
                    <div class="cta-buttons">
                        <a
                            href="#projects"
                            class="btn btn-primary"
                            data-i18n="hero.cta">View My Work</a
                        >
                        <a
                            href="#contact"
                            class="btn btn-secondary"
                            data-i18n="hero.contact">Get In Touch</a
                        >
                    </div>
                </div>
                <div class="hero-visual">
                    <div class="code-window">
                        <div class="window-header">
                            <div class="window-controls">
                                <span class="gnome-btn gnome-close"></span>
                                <span class="gnome-btn gnome-minimize"></span>
                                <span class="gnome-btn gnome-maximize"></span>
                            </div>
                            <span class="window-title"
                                >nvim ~/Developer.cpp</span
                            >
                            <div class="window-menu">
                                <span>⋮</span>
                            </div>
                        </div>
                        <div class="code-content">
                            <Statusline path="Developer.cpp" />
                            <pre><code><span class="line-number"> 1</span> <span class="code-keyword">#include</span> <span class="code-string">&lt;iostream&gt;</span>
<span class="line-number"> 2</span> <span class="code-keyword">#include</span> <span class="code-string">&lt;vector&gt;</span>
<span class="line-number"> 3</span> <span class="code-keyword">#include</span> <span class="code-string">&lt;string&gt;</span>
<span class="line-number"> 4</span>
<span class="line-number"> 5</span> <span class="code-keyword">class</span> <span class="code-class">Developer</span> {'{'}
<span class="line-number"> 6</span> <span class="code-keyword">private</span>:
<span class="line-number"> 7</span>     std::<span class="code-class">string</span> <span class="code-variable">name</span>;
<span class="line-number"> 8</span>     std::<span class="code-class">vector</span>&lt;std::<span class="code-class">string</span>&gt; <span class="code-variable">skills</span>;
<span class="line-number"> 9</span>
<span class="line-number">10</span> <span class="code-keyword">public</span>:
<span class="line-number">11</span>     <span class="code-function">Developer</span>() : <span class="code-variable">name</span>(<span class="code-string">"Gustavo"</span>) {'{'}
<span class="line-number">12</span>         <span class="code-variable">skills</span> = {'{'}<span class="code-string">"C++"</span>, <span class="code-string">"Python"</span>, <span class="code-string">"Algorithms"</span>{'}'};
<span class="line-number">13</span>     {'}'}
<span class="line-number">14</span> {'}'};</code></pre>
                            <div class="nvim-cmdline">
                                <span class="nvim-cmdline-text" id="cmdline-text"></span><span
                                    class="nvim-cursor">█</span
                                >
                                <input
                                    type="text"
                                    id="cmdline-input"
                                    class="nvim-cmdline-input"
                                    autocomplete="off"
                                    spellcheck="false"
                                    autocapitalize="off"
                                    autocorrect="off"
                                    aria-label="Línea de comandos de Neovim"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- About Section -->
        <section id="about" class="about">
            <div class="container">
                <h2 class="section-title" data-i18n="about.title">About Me</h2>
                <p class="about-text" data-i18n="about.text">
                    I'm a passionate software engineer with expertise in
                    building scalable web applications and solving complex
                    technical challenges. With a strong foundation in both
                    frontend and backend technologies, I thrive on creating
                    seamless user experiences and robust system architectures.
                </p>
            </div>
        </section>

        <!-- Skills Section -->
