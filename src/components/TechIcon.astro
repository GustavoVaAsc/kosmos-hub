/*
 * TechIcon.astro — inline SVG logo for a technology/skill tag.
 *
 * Single source of truth for tech icons used in the about-me page. Paths
 * are sourced from simple-icons v16.30.0 (CC0, https://simpleicons.org)
 * and embedded as <path d="..."> data so the rendered HTML has zero
 * network requests and no extra asset files. Adding or updating an icon
 * means looking up the same path from simpleicons.org and editing the
 * ICONS map below — no rebuild tooling required.
 *
 * Usage:
 *   <TechIcon name="c++" />
 *
 * If `name` is not in the icon map (e.g. there is no simple-icons entry
 * for "swiftui" or "llama.cpp"), nothing is rendered — the surrounding
 * `.skill-tag` still shows its plain text label. No emoji fallback, no
 * invented icons.
 */

interface Props {
    name: string;
    /** Optional override for the accessible label. Defaults to `name`. */
    label?: string;
}

const { name, label } = Astro.props;

// Icon map keyed by the slug used in `.skill-tag` text. All paths are
// CC0 from simple-icons.org (https://simpleicons.org), viewBox 0 0 24 24.
