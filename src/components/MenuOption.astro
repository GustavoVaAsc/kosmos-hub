---
interface Props {
    title: string;
    description: string;
    href: string;
    icon: string;
    colorClass?: string;
}

const { title, description, href, icon, colorClass = "default" } = Astro.props;
---

<a href={href} class={`menu-option ${colorClass}`}>
    <div class="menu-icon">{icon}</div>
    <div class="menu-content">
        <h2>{title}</h2>
        <p>{description}</p>
    </div>
    <div class="menu-arrow">→</div>
</a>

<style>
    .menu-option {
        display: flex;
        align-items: center;
        gap: 2rem;
        padding: 2.5rem 3rem;
        background: rgba(255, 255, 255, 0.03);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .menu-option::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.05),
            transparent
        );
        transition: left 0.5s;
    }

    .menu-option:hover::before {
        left: 100%;
    }

    .menu-option:hover {
        transform: translateY(-5px);
        border-color: rgba(255, 255, 255, 0.3);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .menu-icon {
        font-size: 4rem;
        flex-shrink: 0;
        transition: transform 0.3s;
    }

    .menu-option:hover .menu-icon {
        transform: scale(1.1) rotate(5deg);
    }

    .menu-content {
        flex: 1;
    }

    .menu-content h2 {
        font-size: 2rem;
        font-weight: 700;
        margin: 0 0 0.5rem 0;
        background: linear-gradient(
            135deg,
            #fff 0%,
            rgba(255, 255, 255, 0.7) 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .menu-content p {
        margin: 0;
        color: rgba(255, 255, 255, 0.6);
        font-size: 1.1rem;
        line-height: 1.6;
    }

    .menu-arrow {
        font-size: 2.5rem;
        color: rgba(255, 255, 255, 0.4);
        transition: all 0.3s;
        flex-shrink: 0;
    }

    .menu-option:hover .menu-arrow {
        transform: translateX(10px);
        color: rgba(255, 255, 255, 0.8);
    }

    /* Color variations */
    .menu-option.purple:hover {
        background: rgba(139, 92, 246, 0.1);
        border-color: rgba(139, 92, 246, 0.5);
    }

    .menu-option.red:hover {
        background: rgba(239, 68, 68, 0.1);
        border-color: rgba(239, 68, 68, 0.5);
    }

    .menu-option.blue:hover {
        background: rgba(59, 130, 246, 0.1);
        border-color: rgba(59, 130, 246, 0.5);
    }

    @media (max-width: 768px) {
        .menu-option {
            flex-direction: column;
            text-align: center;
            gap: 1.5rem;
            padding: 2rem;
        }

        .menu-icon {
            font-size: 3rem;
        }

        .menu-content h2 {
            font-size: 1.5rem;
        }

        .menu-content p {
            font-size: 1rem;
        }

        .menu-arrow {
            transform: rotate(90deg);
        }

        .menu-option:hover .menu-arrow {
            transform: rotate(90deg) translateX(10px);
        }
    }
</style>
